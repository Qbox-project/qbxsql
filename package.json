{
  "name": "qbxsql",
  "version": "0.3.0",
  "private": true,
  "description": "Database adapter, compatibility layer, and schema manager for FiveM",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/unit tests/contract tests/integration",
    "test:unit": "bun test tests/unit",
    "test:contract": "bun test tests/contract",
    "test:integration": "bun test tests/integration",
    "release": "bun run build && node scripts/build-release.mjs",
    "release:validate": "node scripts/validate-release.mjs",
    "install:dev": "node scripts/install-development.mjs",
    "benchmark:run": "node scripts/run-benchmark.mjs",
    "benchmark:compare": "node scripts/compare-benchmarks.mjs",
    "soak:validate": "node scripts/validate-soak.mjs"
  },
  "dependencies": {
    "mysql2": "3.23.1"
  },
  "devDependencies": {
    "@citizenfx/server": "2.0.32561-1",
    "@types/bun": "1.3.14",
    "@types/node": "22.20.1",
    "esbuild": "0.28.1",
    "typescript": "7.0.2"
  }
}
